# Root-level example — only used by docker-compose (infra/docker) for the
# local Postgres/Redis/MinIO containers. Each app has its own .env.example;
# copy those to .env.local inside the respective app directory.

POSTGRES_USER=fresh_cup
POSTGRES_PASSWORD=fresh_cup
POSTGRES_DB=fresh_cup_dev
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=fresh_cup
MINIO_ROOT_PASSWORD=fresh_cup_minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
