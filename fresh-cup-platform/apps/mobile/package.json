{
  "name": "@fresh-cup/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Fresh Cup — Android + iOS app (Expo / React Native)",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .expo dist .turbo"
  },
  "dependencies": {
    "@expo/log-box": "~57.0.1",
    "@expo/metro-runtime": "~57.0.6",
    "@fresh-cup/api-client": "workspace:*",
    "@fresh-cup/types": "workspace:*",
    "@fresh-cup/utils": "workspace:*",
    "expo": "~57.0.7",
    "expo-constants": "~57.0.6",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.10.0"
  },
  "devDependencies": {
    "@fresh-cup/config": "workspace:*",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.3",
    "eslint": "^9.18.0",
    "eslint-config-expo": "^57.0.0",
    "typescript": "~6.0.3"
  }
}
