// Fresh Cup — Prisma schema.
// Phase 1: identity/auth, RBAC, addresses, catalog (categories + products
// + images), inventory base models.
// Phase 2: modifiers, tables (QR dine-in), cart, orders + status workflow,
// payments (Chapa/cash), coupons, loyalty accrual, notifications.
// Phase 3: kitchen stations + prep timers, driver/delivery management
// (circular zones, GPS tracking), recipe-based automatic inventory
// deduction + low-stock alerts, supplier/purchase-order workflow, audit
// logging, admin/sales dashboards. Phase 5: branch hours, employees/
// departments/shifts/attendance, staff permissions, restaurant settings,
// banners, gift cards, referrals, campaigns, reviews, API keys. Phase 6: AI
// & business intelligence — model registry + forecast snapshots for sales/
// demand forecasting, AI assistant query log. Phase 7: Restaurant
// Intelligence Platform — long-term AI memory (conversations/decisions/
// recommendations/accepted-or-rejected suggestions) and a provider-agnostic
// vector index backing RAG retrieval (see apps/api/src/intelligence/).
// Phase 11 Part 2: Predictive Intelligence Platform — a standalone model
// registry (deployment-stage lifecycle + dataset lineage) and drift alerts
// backing prediction/forecasting/segmentation/drift/training under the same
// apps/api/src/intelligence/ tree. Phase 11 Part 3: Autonomous Restaurant
// Intelligence Platform — the Human Approval Layer, workflow engine,
// knowledge base, and continuous evaluation tables. Phase 8 Part 1:
// Enterprise & Global Restaurant Platform's Enterprise Foundation —
// Organization as the tenant root above Branch, Region/Franchise/
// BranchGroup hierarchy, org-level RBAC, feature flags, licensing, and
// tenant-scoped global config. See fresh-cup-platform/docs/DATABASE_SCHEMA.md
// and docs/ROADMAP.md.
//
// IDs use Prisma's default (client-generated UUIDv4) rather than a
// DB-generated UUIDv7: it needs no Postgres extension, works identically
// in every environment, and index locality isn't a concern at this
// volume — revisit only if that changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Phase 5 adds the granular front-of-house/back-of-house roles the Phase 1
/// comment on this enum deferred (KITCHEN et al.) — STAFF remains as a
/// generic fallback for staff that don't fit a narrower role, so existing
/// seeded/created STAFF accounts keep working unchanged. "Owner" (from the
/// Phase 5 spec) is not a separate role: it's `User.isOwner` on an ADMIN
/// account, since Owner is a permissions superset of Admin, not a disjoint
/// set of endpoints — modeling it as its own enum value would mean
/// duplicating every `@Roles(UserRole.ADMIN)` guard across Phases 1-4.
enum UserRole {
  CUSTOMER
  STAFF
  MANAGER
  ADMIN
  DRIVER
  CASHIER
  KITCHEN
  WAITER
  INVENTORY_STAFF
  MARKETING_STAFF
}

enum Locale {
  EN
  AM
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

/// Org-level roles, layered on top of the existing branch-scoped UserRole
/// (a user can be e.g. MANAGER on their branch's UserRole while also
/// holding ORG_ADMIN via an OrganizationMembership row) — see
/// docs/ROADMAP.md's Phase 8 Part 1 notes for why this is a second,
/// additive role axis rather than a rewrite of UserRole.
enum OrgRole {
  ORG_OWNER
  ORG_ADMIN
  FRANCHISE_ADMIN
  REGION_MANAGER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum InventoryUnit {
  GRAM
  MILLILITER
  UNIT
}

enum InventoryTransactionReason {
  MANUAL_ADJUSTMENT
  RESTOCK
  WASTE
  ORDER_DEDUCTION
}

enum OrderType {
  DINE_IN
  PICKUP
  DELIVERY
}

/// pending_payment -> confirmed -> preparing -> ready -> {completed | out_for_delivery -> delivered -> completed}
/// any non-terminal state -> cancelled. Enforced in OrdersService, not the DB.
enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum ModifierSelectionType {
  SINGLE
  MULTIPLE
}

enum PaymentProvider {
  CHAPA
  CASH
}

enum PaymentMethod {
  TELEBIRR
  CBE_BIRR
  HELLOCASH
  AMOLE
  CARD
  CASH
}

enum PaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENT
  AMOUNT
  FREE_DELIVERY
}

/// REDEEMED/rewards-catalog reasons land in Phase 4 (Loyalty & promotions)
/// alongside the redemption flow itself — Phase 2 only accrues.
enum LoyaltyReason {
  ORDER_EARNED
  MANUAL_ADJUSTMENT
}

enum PushPlatform {
  IOS
  ANDROID
  WEB
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  SENT
  FAILED
  SKIPPED
}

enum DeliveryStatus {
  UNASSIGNED
  ASSIGNED
  PICKED_UP
  EN_ROUTE
  DELIVERED
  FAILED
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  RECEIVED
  CANCELLED
}

/// Phase 5 — admin platform.
/// Fine-grained, additive capability grants layered on top of the fixed
/// `UserRole` enum (see the comment there) — this is how "custom roles"
/// from the Phase 5 spec is implemented: a manager can grant a CASHIER
/// account MENU_EDIT without needing a new role enum value or touching any
/// existing `@Roles()` guard.
enum PermissionKey {
  MENU_EDIT
  INVENTORY_MANAGE
  PURCHASING_MANAGE
  EMPLOYEE_MANAGE
  MARKETING_MANAGE
  SETTINGS_MANAGE
  REPORTS_VIEW
  FINANCE_VIEW
}

enum ShiftStatus {
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

enum CampaignChannel {
  PUSH
  EMAIL
  SMS
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  CANCELLED
}

enum CampaignSegment {
  ALL_CUSTOMERS
  ACTIVE_CUSTOMERS
  INACTIVE_CUSTOMERS
  VIP_CUSTOMERS
}

/// Phase 6 — AI & Business Intelligence.
/// What a model run predicts. One enum value per forecasting surface in the
/// spec (daily/weekly/monthly sales collapse to one REVENUE/ORDERS pair
/// distinguished by `ForecastGranularity`, not separate metrics).
enum ForecastMetric {
  SALES_REVENUE
  SALES_ORDERS
  HOURLY_DEMAND
  PRODUCT_DEMAND
  INGREDIENT_DEMAND
}

enum ForecastGranularity {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
}

enum MlModelStatus {
  READY
  FAILED
}

enum AiQueryOutcome {
  ANSWERED
  FALLBACK
  ERROR
}

// ---------------------------------------------------------------------------
// Branches
// ---------------------------------------------------------------------------

model Branch {
  id             String       @id @default(uuid())
  name           String
  addressText    String       @map("address_text")
  lat            Decimal?     @db.Decimal(9, 6)
  lng            Decimal?     @db.Decimal(9, 6)
  phone          String?
  isActive       Boolean      @default(true) @map("is_active")
  managerId      String?      @map("manager_id")
  manager        User?        @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  /// Phase 8 Part 1 — every Branch belongs to exactly one Organization
  /// (the tenant root). Required, not nullable: the migration backfills a
  /// single default Organization for every branch that existed before
  /// this phase, so tenant scoping is real from row one rather than an
  /// opt-in nullable column.
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  regionId       String?      @map("region_id")
  region         Region?      @relation(fields: [regionId], references: [id], onDelete: SetNull)
  franchiseId    String?      @map("franchise_id")
  franchise      Franchise?   @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  users                  User[]
  menuCategories         MenuCategory[]
  menuItems              MenuItem[]
  inventoryItems         InventoryItem[]
  tables                 Table[]
  modifierGroups         ModifierGroup[]
  carts                  Cart[]
  orders                 Order[]
  kitchenStations        KitchenStation[]
  deliveryZones          DeliveryZone[]
  deliveries             Delivery[]
  suppliers              Supplier[]
  purchaseOrders         PurchaseOrder[]
  hours                  BranchHours[]
  departments            Department[]
  shifts                 Shift[]
  attendances            Attendance[]
  banners                Banner[]
  forecastSnapshots      ForecastSnapshot[]
  aiMemoryEntries        AiMemoryEntry[]
  aiApprovalRequests     AiApprovalRequest[]
  branchGroupMemberships BranchGroupMembership[]
  featureFlagOverrides   FeatureFlagOverride[]

  @@index([managerId])
  @@index([organizationId])
  @@index([regionId])
  @@index([franchiseId])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id               String      @id @default(uuid())
  phone            String?     @unique
  email            String?     @unique
  passwordHash     String?     @map("password_hash")
  fullName         String      @map("full_name")
  role             UserRole    @default(CUSTOMER)
  branchId         String?     @map("branch_id")
  branch           Branch?     @relation(fields: [branchId], references: [id])
  locale           Locale      @default(EN)
  isActive         Boolean     @default(true) @map("is_active")
  /// Owner is a permissions superset of Admin on the same ADMIN role — see
  /// the UserRole enum comment for why this isn't a separate role value.
  isOwner          Boolean     @default(false) @map("is_owner")
  departmentId     String?     @map("department_id")
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  /// Employee-facing placeholder, not a payroll system — see Phase 5 scope
  /// notes in docs/ROADMAP.md. Only ever read/written by ADMIN-gated
  /// endpoints; never included in the customer-facing `/users/me` response.
  salary           Decimal?    @db.Decimal(10, 2)
  twoFactorEnabled Boolean     @default(false) @map("two_factor_enabled")
  /// Set once during enrollment, cleared on disable — never returned by any
  /// endpoint after enrollment completes.
  twoFactorSecret  String?     @map("two_factor_secret")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  addresses                Address[]
  refreshTokens            RefreshToken[]
  inventoryTransactions    InventoryTransaction[]
  carts                    Cart[]
  orders                   Order[]
  orderStatusChanges       OrderStatusHistory[]
  loyaltyEntries           LoyaltyLedger[]
  pushTokens               PushToken[]
  couponRedemptions        CouponRedemption[]
  notificationLogs         NotificationLog[]
  driverProfile            DriverProfile?
  deliveriesAsDriver       Delivery[]
  createdPurchaseOrders    PurchaseOrder[]
  auditLogs                AuditLog[]
  managedBranches          Branch[]                  @relation("BranchManager")
  shifts                   Shift[]
  attendances              Attendance[]
  permissionsGranted       StaffPermission[]         @relation("PermissionSubject")
  permissionsAwarded       StaffPermission[]         @relation("PermissionGrantedBy")
  performanceNotes         PerformanceNote[]         @relation("PerformanceSubject")
  performanceNotesAuthored PerformanceNote[]         @relation("PerformanceAuthor")
  giftCardsReceived        GiftCard[]
  referralCode             ReferralCode?
  referralRedemption       ReferralRedemption?
  productReviews           ProductReview[]
  campaignsCreated         Campaign[]
  apiKeysCreated           ApiKey[]
  aiAssistantQueries       AiAssistantQuery[]
  aiMemoriesAbout          AiMemoryEntry[]           @relation("AiMemorySubject")
  aiMemoriesAuthored       AiMemoryEntry[]           @relation("AiMemoryAuthor")
  aiApprovalsReviewed      AiApprovalRequest[]       @relation("AiApprovalReviewer")
  aiRecommendationsDecided AiRecommendationOutcome[] @relation("AiRecommendationDecider")
  organizationMemberships  OrganizationMembership[]
  franchisesOwned          Franchise[]               @relation("FranchiseOwner")
  webAuthnCredentials      WebAuthnCredential[]
  trustedDevices           TrustedDevice[]

  @@index([branchId])
  @@index([departmentId])
  @@map("users")
}

model OtpCode {
  id           String    @id @default(uuid())
  phone        String
  codeHash     String    @map("code_hash")
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  attemptCount Int       @default(0) @map("attempt_count")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@map("otp_codes")
}

/// Refresh tokens are opaque random values, stored only as a hash — this
/// table exists purely so a token can be revoked/rotated server-side,
/// which a self-contained JWT refresh token could not support.
model RefreshToken {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Addresses
// ---------------------------------------------------------------------------

model Address {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  freeText  String   @map("free_text")
  lat       Decimal? @db.Decimal(9, 6)
  lng       Decimal? @db.Decimal(9, 6)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model MenuCategory {
  id        String   @id @default(uuid())
  branchId  String   @map("branch_id")
  branch    Branch   @relation(fields: [branchId], references: [id])
  nameEn    String   @map("name_en")
  nameAm    String?  @map("name_am")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  menuItems MenuItem[]

  @@index([branchId])
  @@map("menu_categories")
}

model MenuItem {
  id              String          @id @default(uuid())
  branchId        String          @map("branch_id")
  branch          Branch          @relation(fields: [branchId], references: [id])
  categoryId      String          @map("category_id")
  category        MenuCategory    @relation(fields: [categoryId], references: [id])
  nameEn          String          @map("name_en")
  nameAm          String?         @map("name_am")
  descriptionEn   String?         @map("description_en")
  descriptionAm   String?         @map("description_am")
  basePrice       Int             @map("base_price")
  isAvailable     Boolean         @default(true) @map("is_available")
  calories        Int?
  /// Free-form nutrition facts (protein/carbs/fat/sugar grams, etc.) —
  /// deliberately a JSON bag rather than dedicated columns, since which
  /// facts a given product publishes varies and the customer-facing app
  /// doesn't currently render it structured beyond `calories`.
  nutrition       Json?
  tags            String[]        @default([])
  isPopular       Boolean         @default(false) @map("is_popular")
  isFeatured      Boolean         @default(false) @map("is_featured")
  isSeasonal      Boolean         @default(false) @map("is_seasonal")
  sortOrder       Int             @default(0) @map("sort_order")
  /// Estimated prep time — used to flag a kitchen-queue order as running
  /// late (elapsed since `preparingAt` vs. the max across its items).
  prepTimeSeconds Int             @default(180) @map("prep_time_seconds")
  stationId       String?         @map("station_id")
  station         KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  images             MenuItemImage[]
  modifierGroupLinks MenuItemModifierGroup[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  recipeIngredients  RecipeIngredient[]
  reviews            ProductReview[]
  forecastSnapshots  ForecastSnapshot[]

  @@index([branchId, categoryId])
  @@index([branchId, isAvailable])
  @@index([stationId])
  @@map("menu_items")
}

model MenuItemImage {
  id         String   @id @default(uuid())
  menuItemId String   @map("menu_item_id")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  url        String
  altText    String?  @map("alt_text")
  isPrimary  Boolean  @default(false) @map("is_primary")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([menuItemId])
  @@map("menu_item_images")
}

// ---------------------------------------------------------------------------
// Inventory (base models — recipe-based deduction lands with ordering)
// ---------------------------------------------------------------------------

model InventoryItem {
  id               String        @id @default(uuid())
  branchId         String        @map("branch_id")
  branch           Branch        @relation(fields: [branchId], references: [id])
  name             String
  unit             InventoryUnit
  currentStock     Decimal       @default(0) @map("current_stock") @db.Decimal(12, 3)
  reorderThreshold Decimal       @default(0) @map("reorder_threshold") @db.Decimal(12, 3)
  unitCost         Int           @map("unit_cost")
  /// Phase 6 — how many days a fresh restock is expected to stay usable.
  /// Null for items that don't meaningfully expire (e.g. disposable cups)
  /// — InventoryIntelligenceService.expiryRisk treats null as "not
  /// applicable" rather than 0 risk.
  shelfLifeDays    Int?          @map("shelf_life_days")
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  transactions       InventoryTransaction[]
  recipeIngredients  RecipeIngredient[]
  purchaseOrderLines PurchaseOrderLine[]
  forecastSnapshots  ForecastSnapshot[]

  @@index([branchId])
  @@map("inventory_items")
}

/// Append-only ledger — every stock change is a row, `InventoryItem.currentStock`
/// is a cached projection kept in sync by the service layer.
model InventoryTransaction {
  id              String                     @id @default(uuid())
  inventoryItemId String                     @map("inventory_item_id")
  inventoryItem   InventoryItem              @relation(fields: [inventoryItemId], references: [id])
  delta           Decimal                    @db.Decimal(12, 3)
  reason          InventoryTransactionReason
  note            String?
  actorUserId     String?                    @map("actor_user_id")
  actorUser       User?                      @relation(fields: [actorUserId], references: [id])
  createdAt       DateTime                   @default(now()) @map("created_at")

  @@index([inventoryItemId, createdAt])
  @@map("inventory_transactions")
}

// ---------------------------------------------------------------------------
// Modifiers (Phase 2 — sizes, add-ons; "variants" are modeled as a SINGLE-
// selection modifier group rather than a separate concept)
// ---------------------------------------------------------------------------

model ModifierGroup {
  id            String                @id @default(uuid())
  branchId      String                @map("branch_id")
  branch        Branch                @relation(fields: [branchId], references: [id])
  nameEn        String                @map("name_en")
  nameAm        String?               @map("name_am")
  selectionType ModifierSelectionType @map("selection_type")
  minSelect     Int                   @default(0) @map("min_select")
  maxSelect     Int?                  @map("max_select")
  isActive      Boolean               @default(true) @map("is_active")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  options       ModifierOption[]
  menuItemLinks MenuItemModifierGroup[]

  @@index([branchId])
  @@map("modifier_groups")
}

model ModifierOption {
  id              String        @id @default(uuid())
  modifierGroupId String        @map("modifier_group_id")
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  nameEn          String        @map("name_en")
  nameAm          String?       @map("name_am")
  priceDelta      Int           @default(0) @map("price_delta")
  isActive        Boolean       @default(true) @map("is_active")
  sortOrder       Int           @default(0) @map("sort_order")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  cartItemModifiers  CartItemModifier[]
  orderItemModifiers OrderItemModifier[]

  @@index([modifierGroupId])
  @@map("modifier_options")
}

/// Join table: which modifier groups apply to which menu item, with
/// per-item overrides (e.g. "Size" is required on drinks but wouldn't be
/// on a pastry that also offers it).
model MenuItemModifierGroup {
  id              String        @id @default(uuid())
  menuItemId      String        @map("menu_item_id")
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroupId String        @map("modifier_group_id")
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  isRequired      Boolean       @default(false) @map("is_required")
  sortOrder       Int           @default(0) @map("sort_order")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([menuItemId, modifierGroupId])
  @@index([modifierGroupId])
  @@map("menu_item_modifier_groups")
}

// ---------------------------------------------------------------------------
// Tables (QR dine-in)
// ---------------------------------------------------------------------------

model Table {
  id        String   @id @default(uuid())
  branchId  String   @map("branch_id")
  branch    Branch   @relation(fields: [branchId], references: [id])
  label     String
  qrToken   String   @unique @map("qr_token")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@index([branchId])
  @@map("tables")
}

// ---------------------------------------------------------------------------
// Cart — server-persisted so it survives across devices/sessions. One cart
// per (user, branch); checkout consumes and clears it rather than tracking
// a cart lifecycle status.
// ---------------------------------------------------------------------------

model Cart {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String   @map("branch_id")
  branch    Branch   @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items CartItem[]

  @@unique([userId, branchId])
  @@map("carts")
}

model CartItem {
  id         String   @id @default(uuid())
  cartId     String   @map("cart_id")
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItemId String   @map("menu_item_id")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int      @default(1)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  modifiers CartItemModifier[]

  @@index([cartId])
  @@map("cart_items")
}

model CartItemModifier {
  id               String         @id @default(uuid())
  cartItemId       String         @map("cart_item_id")
  cartItem         CartItem       @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  modifierOptionId String         @map("modifier_option_id")
  modifierOption   ModifierOption @relation(fields: [modifierOptionId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now()) @map("created_at")

  @@unique([cartItemId, modifierOptionId])
  @@map("cart_item_modifiers")
}

// ---------------------------------------------------------------------------
// Orders — immutable once placed; line items and modifiers snapshot
// name/price so later catalog edits never change a historical order.
// ---------------------------------------------------------------------------

model Order {
  id        String    @id @default(uuid())
  branchId  String    @map("branch_id")
  branch    Branch    @relation(fields: [branchId], references: [id])
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  orderType OrderType @map("order_type")

  tableId String? @map("table_id")
  table   Table?  @relation(fields: [tableId], references: [id])

  addressId           String?  @map("address_id")
  address             Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  deliveryAddressText String?  @map("delivery_address_text")
  deliveryLat         Decimal? @map("delivery_lat") @db.Decimal(9, 6)
  deliveryLng         Decimal? @map("delivery_lng") @db.Decimal(9, 6)

  status OrderStatus @default(PENDING_PAYMENT)

  subtotal      Int
  discountTotal Int    @default(0) @map("discount_total")
  deliveryFee   Int    @default(0) @map("delivery_fee")
  taxTotal      Int    @default(0) @map("tax_total")
  total         Int
  currency      String @default("ETB")

  couponId String? @map("coupon_id")
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  idempotencyKey String  @unique @map("idempotency_key")
  notes          String?

  placedAt    DateTime  @default(now()) @map("placed_at")
  preparingAt DateTime? @map("preparing_at")
  confirmedAt DateTime? @map("confirmed_at")
  readyAt     DateTime? @map("ready_at")
  deliveredAt DateTime? @map("delivered_at")
  cancelledAt DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items                OrderItem[]
  statusHistory        OrderStatusHistory[]
  payments             Payment[]
  couponRedemption     CouponRedemption?
  loyaltyEntries       LoyaltyLedger[]
  delivery             Delivery?
  productReviews       ProductReview[]
  giftCardTransactions GiftCardTransaction[]
  referralRedemption   ReferralRedemption?

  @@index([branchId, status, createdAt])
  @@index([userId, createdAt])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId      String   @map("menu_item_id")
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id])
  nameSnapshot    String   @map("name_snapshot")
  unitPrice       Int      @map("unit_price")
  quantity        Int
  lineTotal       Int      @map("line_total")
  notes           String?
  /// Snapshotted from the menu item at order time — KDS station routing
  /// and lateness detection stay stable even if the item's own station or
  /// estimated prep time changes later.
  stationId       String?  @map("station_id")
  prepTimeSeconds Int      @map("prep_time_seconds")
  createdAt       DateTime @default(now()) @map("created_at")

  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([stationId])
  @@map("order_items")
}

model OrderItemModifier {
  id                 String          @id @default(uuid())
  orderItemId        String          @map("order_item_id")
  orderItem          OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOptionId   String?         @map("modifier_option_id")
  modifierOption     ModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: SetNull)
  nameSnapshot       String          @map("name_snapshot")
  priceDeltaSnapshot Int             @map("price_delta_snapshot")
  createdAt          DateTime        @default(now()) @map("created_at")

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

/// Append-only audit trail powering "Order Timeline" — one row per status
/// transition, independent of the timestamp columns cached on `Order`.
model OrderStatusHistory {
  id              String       @id @default(uuid())
  orderId         String       @map("order_id")
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus      OrderStatus? @map("from_status")
  toStatus        OrderStatus  @map("to_status")
  changedByUserId String?      @map("changed_by_user_id")
  changedByUser   User?        @relation(fields: [changedByUserId], references: [id])
  note            String?
  createdAt       DateTime     @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  id                String          @id @default(uuid())
  orderId           String          @map("order_id")
  order             Order           @relation(fields: [orderId], references: [id])
  provider          PaymentProvider
  method            PaymentMethod
  providerReference String?         @unique @map("provider_reference")
  amount            Int
  currency          String          @default("ETB")
  status            PaymentStatus   @default(INITIATED)
  rawWebhookPayload Json?           @map("raw_webhook_payload")
  initiatedAt       DateTime        @default(now()) @map("initiated_at")
  completedAt       DateTime?       @map("completed_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Promotions
// ---------------------------------------------------------------------------

model Coupon {
  id                    String       @id @default(uuid())
  code                  String       @unique
  discountType          DiscountType @map("discount_type")
  value                 Int          @default(0)
  minOrderTotal         Int?         @map("min_order_total")
  startsAt              DateTime?    @map("starts_at")
  expiresAt             DateTime?    @map("expires_at")
  maxRedemptions        Int?         @map("max_redemptions")
  maxRedemptionsPerUser Int?         @map("max_redemptions_per_user")
  isActive              Boolean      @default(true) @map("is_active")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  redemptions CouponRedemption[]
  orders      Order[]

  @@map("coupons")
}

model CouponRedemption {
  id         String   @id @default(uuid())
  couponId   String   @map("coupon_id")
  coupon     Coupon   @relation(fields: [couponId], references: [id])
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  orderId    String   @unique @map("order_id")
  order      Order    @relation(fields: [orderId], references: [id])
  redeemedAt DateTime @default(now()) @map("redeemed_at")

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

// ---------------------------------------------------------------------------
// Loyalty (accrual only — redemption/rewards catalog is Phase 4)
// ---------------------------------------------------------------------------

/// Append-only ledger; a user's balance is the sum of their entries,
/// cached on each row as `balanceAfter` so history never needs recompute.
model LoyaltyLedger {
  id           String        @id @default(uuid())
  userId       String        @map("user_id")
  user         User          @relation(fields: [userId], references: [id])
  orderId      String?       @map("order_id")
  order        Order?        @relation(fields: [orderId], references: [id])
  pointsDelta  Int           @map("points_delta")
  reason       LoyaltyReason
  balanceAfter Int           @map("balance_after")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("loyalty_ledger")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model PushToken {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String       @unique
  platform  PushPlatform
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_tokens")
}

/// Audit trail of dispatched notifications — every send attempt (any
/// channel) is a row, regardless of outcome.
model NotificationLog {
  id        String              @id @default(uuid())
  userId    String?             @map("user_id")
  user      User?               @relation(fields: [userId], references: [id])
  channel   NotificationChannel
  type      String
  payload   Json
  status    NotificationStatus
  error     String?
  createdAt DateTime            @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("notification_logs")
}

// ---------------------------------------------------------------------------
// Kitchen (Phase 3)
// ---------------------------------------------------------------------------

/// A physical prep station (e.g. "Cold Bar", "Grill", "Assembly"). Menu items
/// optionally route to one; the kitchen queue can filter to a single
/// station's display.
model KitchenStation {
  id        String   @id @default(uuid())
  branchId  String   @map("branch_id")
  branch    Branch   @relation(fields: [branchId], references: [id])
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  menuItems MenuItem[]

  @@index([branchId])
  @@map("kitchen_stations")
}

// ---------------------------------------------------------------------------
// Delivery (Phase 3)
// ---------------------------------------------------------------------------

/// 1:1 extension of a User with role DRIVER — kept separate from `users`
/// rather than adding driver-only columns there, same reasoning as keeping
/// staff/customer concerns off shared columns.
model DriverProfile {
  userId       String    @id @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType  String    @map("vehicle_type")
  licensePlate String?   @map("license_plate")
  isOnline     Boolean   @default(false) @map("is_online")
  currentLat   Decimal?  @map("current_lat") @db.Decimal(9, 6)
  currentLng   Decimal?  @map("current_lng") @db.Decimal(9, 6)
  lastPingAt   DateTime? @map("last_ping_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("driver_profiles")
}

/// Circular catchment (center + radius) rather than a GeoJSON polygon —
/// no PostGIS dependency, and haversine-distance-from-center is sufficient
/// at single-branch delivery-radius scale. Revisit only if irregular
/// (non-circular) coverage areas are actually needed.
model DeliveryZone {
  id        String   @id @default(uuid())
  branchId  String   @map("branch_id")
  branch    Branch   @relation(fields: [branchId], references: [id])
  name      String
  centerLat Decimal  @map("center_lat") @db.Decimal(9, 6)
  centerLng Decimal  @map("center_lng") @db.Decimal(9, 6)
  radiusKm  Decimal  @map("radius_km") @db.Decimal(6, 2)
  baseFee   Int      @map("base_fee")
  perKmFee  Int      @default(0) @map("per_km_fee")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deliveries Delivery[]

  @@index([branchId])
  @@map("delivery_zones")
}

model Delivery {
  id          String         @id @default(uuid())
  orderId     String         @unique @map("order_id")
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  branchId    String         @map("branch_id")
  branch      Branch         @relation(fields: [branchId], references: [id])
  driverId    String?        @map("driver_id")
  driver      User?          @relation(fields: [driverId], references: [id])
  zoneId      String?        @map("zone_id")
  zone        DeliveryZone?  @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  status      DeliveryStatus @default(UNASSIGNED)
  distanceKm  Decimal?       @map("distance_km") @db.Decimal(6, 2)
  fee         Int
  assignedAt  DateTime?      @map("assigned_at")
  pickedUpAt  DateTime?      @map("picked_up_at")
  deliveredAt DateTime?      @map("delivered_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  trackingPings DeliveryTrackingPing[]

  @@index([branchId, status])
  @@index([driverId])
  @@map("deliveries")
}

/// Append-only GPS trail — short retention in practice (e.g. 30 days),
/// used for the live map and post-hoc SLA analysis.
model DeliveryTrackingPing {
  id         String   @id @default(uuid())
  deliveryId String   @map("delivery_id")
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  lat        Decimal  @db.Decimal(9, 6)
  lng        Decimal  @db.Decimal(9, 6)
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@index([deliveryId, recordedAt])
  @@map("delivery_tracking_pings")
}

// ---------------------------------------------------------------------------
// Recipes & purchasing (Phase 3)
// ---------------------------------------------------------------------------

/// Menu item -> ingredient mapping. Drives automatic inventory deduction on
/// `order.paid` (see OrdersModule/InventoryModule event wiring) — a menu
/// item with no rows here simply doesn't deduct anything, so this can be
/// filled in incrementally without breaking existing items.
model RecipeIngredient {
  id              String        @id @default(uuid())
  menuItemId      String        @map("menu_item_id")
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItemId String        @map("inventory_item_id")
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantityPerUnit Decimal       @map("quantity_per_unit") @db.Decimal(12, 3)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@unique([menuItemId, inventoryItemId])
  @@index([inventoryItemId])
  @@map("recipe_ingredients")
}

model Supplier {
  id          String   @id @default(uuid())
  branchId    String   @map("branch_id")
  branch      Branch   @relation(fields: [branchId], references: [id])
  name        String
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]

  @@index([branchId])
  @@map("suppliers")
}

model PurchaseOrder {
  id              String              @id @default(uuid())
  branchId        String              @map("branch_id")
  branch          Branch              @relation(fields: [branchId], references: [id])
  supplierId      String              @map("supplier_id")
  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  status          PurchaseOrderStatus @default(DRAFT)
  notes           String?
  createdByUserId String?             @map("created_by_user_id")
  createdByUser   User?               @relation(fields: [createdByUserId], references: [id])
  submittedAt     DateTime?           @map("submitted_at")
  receivedAt      DateTime?           @map("received_at")
  /// Phase 5: an uploaded/entered invoice reference for the PO — no OCR or
  /// accounting-system integration, just a record of "here's the invoice".
  invoiceNumber   String?             @map("invoice_number")
  invoiceUrl      String?             @map("invoice_url")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  lines    PurchaseOrderLine[]
  payments PurchaseOrderPayment[]

  @@index([branchId, status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id               String        @id @default(uuid())
  purchaseOrderId  String        @map("purchase_order_id")
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItemId  String        @map("inventory_item_id")
  inventoryItem    InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantityOrdered  Decimal       @map("quantity_ordered") @db.Decimal(12, 3)
  unitCost         Int           @map("unit_cost")
  quantityReceived Decimal?      @map("quantity_received") @db.Decimal(12, 3)

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

// ---------------------------------------------------------------------------
// Audit log (Phase 3)
// ---------------------------------------------------------------------------

/// Written by AuditLogInterceptor for every mutating (POST/PATCH/PUT/DELETE)
/// request on a controller tagged @Auditable(...) — captures who did what
/// to which entity and the resulting state. Deliberately "after" state only
/// (no pre-fetched "before" diff) to avoid an extra read on every mutation;
/// see docs/API_DESIGN.md for the exact coverage list.
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  actorUser   User?    @relation(fields: [actorUserId], references: [id])
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  after       Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model PurchaseOrderPayment {
  id              String        @id @default(uuid())
  purchaseOrderId String        @map("purchase_order_id")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  amount          Int
  method          String
  note            String?
  paidAt          DateTime      @default(now()) @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([purchaseOrderId])
  @@map("purchase_order_payments")
}

// ---------------------------------------------------------------------------
// Phase 5 — Admin platform: branch hours, employees, settings, marketing,
// reviews, security. Every model below is purely additive — nothing above
// this section changes shape, so Phases 1-4 keep working unmodified.
// ---------------------------------------------------------------------------

/// One row per (branch, day-of-week 0=Sunday..6=Saturday). Times are plain
/// "HH:mm" strings rather than DateTime — these are wall-clock opening
/// hours, not instants, and a bare TIME column buys nothing extra here.
model BranchHours {
  id        String   @id @default(uuid())
  branchId  String   @map("branch_id")
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dayOfWeek Int      @map("day_of_week")
  opensAt   String?  @map("opens_at")
  closesAt  String?  @map("closes_at")
  isClosed  Boolean  @default(false) @map("is_closed")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([branchId, dayOfWeek])
  @@map("branch_hours")
}

model Department {
  id        String   @id @default(uuid())
  branchId  String?  @map("branch_id")
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employees User[]

  @@index([branchId])
  @@map("departments")
}

model Shift {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String      @map("branch_id")
  branch    Branch      @relation(fields: [branchId], references: [id])
  startsAt  DateTime    @map("starts_at")
  endsAt    DateTime    @map("ends_at")
  status    ShiftStatus @default(SCHEDULED)
  notes     String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([branchId, startsAt])
  @@index([userId, startsAt])
  @@map("shifts")
}

/// Simple clock-in/clock-out record — one open row (`clockOutAt` null) per
/// user at a time, enforced at the service layer, not the DB.
model Attendance {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId   String    @map("branch_id")
  branch     Branch    @relation(fields: [branchId], references: [id])
  clockInAt  DateTime  @default(now()) @map("clock_in_at")
  clockOutAt DateTime? @map("clock_out_at")
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, clockInAt])
  @@index([branchId, clockInAt])
  @@map("attendances")
}

/// Additive per-user capability grants — see the PermissionKey enum comment
/// for why this exists alongside the fixed UserRole enum.
model StaffPermission {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  user            User          @relation("PermissionSubject", fields: [userId], references: [id], onDelete: Cascade)
  permission      PermissionKey
  grantedByUserId String?       @map("granted_by_user_id")
  grantedByUser   User?         @relation("PermissionGrantedBy", fields: [grantedByUserId], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([userId, permission])
  @@index([userId])
  @@map("staff_permissions")
}

model PerformanceNote {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation("PerformanceSubject", fields: [userId], references: [id], onDelete: Cascade)
  authorUserId String?  @map("author_user_id")
  authorUser   User?    @relation("PerformanceAuthor", fields: [authorUserId], references: [id])
  rating       Int?
  note         String
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("performance_notes")
}

/// Single-row (or one row per key area) global configuration — a singleton
/// pattern enforced at the service layer (get-or-create the one row) rather
/// than a schema constraint, matching how `RestaurantSettingsService` reads
/// it. Deliberately does NOT hold payment/SMS/email provider credentials —
/// those stay in environment variables, same as every provider since Phase
/// 2 (`ConsoleSmsProvider`, Chapa keys, ...); this only holds
/// business-facing configuration an owner edits from the UI.
model RestaurantSettings {
  id                 String   @id @default(uuid())
  restaurantName     String   @default("Fresh Cup Juice House") @map("restaurant_name")
  defaultLocale      Locale   @default(EN) @map("default_locale")
  defaultCurrency    String   @default("ETB") @map("default_currency")
  defaultTaxPercent  Decimal  @default(0) @map("default_tax_percent") @db.Decimal(5, 2)
  timezone           String   @default("Africa/Addis_Ababa")
  logoUrl            String?  @map("logo_url")
  primaryColorHex    String?  @map("primary_color_hex")
  supportEmail       String?  @map("support_email")
  supportPhone       String?  @map("support_phone")
  emailNotifications Boolean  @default(true) @map("email_notifications")
  smsNotifications   Boolean  @default(true) @map("sms_notifications")
  pushNotifications  Boolean  @default(true) @map("push_notifications")
  updatedByUserId    String?  @map("updated_by_user_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("restaurant_settings")
}

model Banner {
  id        String    @id @default(uuid())
  branchId  String?   @map("branch_id")
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  title     String
  imageUrl  String    @map("image_url")
  linkUrl   String?   @map("link_url")
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([branchId, isActive])
  @@map("banners")
}

model GiftCard {
  id             String    @id @default(uuid())
  code           String    @unique
  initialBalance Int       @map("initial_balance")
  currentBalance Int       @map("current_balance")
  issuedToUserId String?   @map("issued_to_user_id")
  issuedToUser   User?     @relation(fields: [issuedToUserId], references: [id])
  isActive       Boolean   @default(true) @map("is_active")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  transactions GiftCardTransaction[]

  @@map("gift_cards")
}

/// Append-only ledger, same pattern as InventoryTransaction/LoyaltyLedger —
/// `GiftCard.currentBalance` is a cached projection kept in sync by the
/// service layer.
model GiftCardTransaction {
  id         String   @id @default(uuid())
  giftCardId String   @map("gift_card_id")
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  amount     Int
  orderId    String?  @map("order_id")
  order      Order?   @relation(fields: [orderId], references: [id])
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([giftCardId, createdAt])
  @@map("gift_card_transactions")
}

model ReferralCode {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code         String   @unique
  rewardAmount Int      @map("reward_amount")
  usesCount    Int      @default(0) @map("uses_count")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  redemptions ReferralRedemption[]

  @@map("referral_codes")
}

/// One redemption per referred user, enforced by `@unique` on
/// `referredUserId` — a customer can only have been referred once.
model ReferralRedemption {
  id             String       @id @default(uuid())
  referralCodeId String       @map("referral_code_id")
  referralCode   ReferralCode @relation(fields: [referralCodeId], references: [id])
  referredUserId String       @unique @map("referred_user_id")
  referredUser   User         @relation(fields: [referredUserId], references: [id])
  orderId        String?      @unique @map("order_id")
  order          Order?       @relation(fields: [orderId], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([referralCodeId])
  @@map("referral_redemptions")
}

/// Send-side reuses the existing Phase 2 console SMS/email/push providers
/// (see `NotificationsModule`) — sending a campaign is dispatching one
/// notification per targeted user through those same provider interfaces,
/// not a new delivery pipeline. `targetSegment` selects the recipient set
/// at send time rather than storing a materialized recipient list.
model Campaign {
  id              String          @id @default(uuid())
  name            String
  channel         CampaignChannel
  message         String
  targetSegment   CampaignSegment @default(ALL_CUSTOMERS) @map("target_segment")
  status          CampaignStatus  @default(DRAFT)
  scheduledAt     DateTime?       @map("scheduled_at")
  sentAt          DateTime?       @map("sent_at")
  recipientCount  Int?            @map("recipient_count")
  createdByUserId String?         @map("created_by_user_id")
  createdByUser   User?           @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([status, scheduledAt])
  @@map("campaigns")
}

model ProductReview {
  id         String   @id @default(uuid())
  menuItemId String   @map("menu_item_id")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId    String?  @map("order_id")
  order      Order?   @relation(fields: [orderId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([menuItemId, userId])
  @@index([menuItemId])
  @@map("product_reviews")
}

/// Admin-managed API keys for external integrations — the key itself is
/// shown once at creation and only its hash (same pattern as
/// RefreshToken.tokenHash) is stored.
model ApiKey {
  id              String    @id @default(uuid())
  name            String
  keyHash         String    @unique @map("key_hash")
  keyPrefix       String    @map("key_prefix")
  createdByUserId String?   @map("created_by_user_id")
  createdByUser   User?     @relation(fields: [createdByUserId], references: [id])
  lastUsedAt      DateTime? @map("last_used_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([createdByUserId])
  @@map("api_keys")
}

// ---------------------------------------------------------------------------
// Phase 6 — AI & Business Intelligence. Purely additive, same as Phase 5's
// section above: nothing before this line changes shape.
//
// Recommendations, customer intelligence (RFM/LTV/churn), inventory
// intelligence, and marketing intelligence are deliberately NOT modeled here
// — they're computed on demand from existing tables (Order/OrderItem/
// LoyaltyLedger/CouponRedemption/...), the same "on-demand aggregate query"
// approach AnalyticsService and InventoryService.predictedShortages already
// use, rather than adding materialized/cached tables for them. Only sales
// forecasting needs persistence: "forecast vs actual" requires the
// prediction to outlive the day it was made, and "replaceable/versioned
// models" requires a registry row to version against.
// ---------------------------------------------------------------------------

/// One row per forecast-generation run (e.g. "sales-forecast", nightly). A
/// model here is a hand-rolled statistical method (moving average / linear
/// regression over Order history — see ForecastingService), not a trained
/// artifact — `version` still lets an admin see which run a snapshot came
/// from, and `metrics` holds its offline evaluation (e.g. MAPE against the
/// trailing window) without needing a separate experiment-tracking system.
model MlModelRun {
  id        String        @id @default(uuid())
  modelKey  String        @map("model_key")
  version   Int
  status    MlModelStatus @default(READY)
  metrics   Json?
  notes     String?
  trainedAt DateTime      @default(now()) @map("trained_at")

  forecastSnapshots ForecastSnapshot[]

  @@unique([modelKey, version])
  @@index([modelKey, trainedAt])
  @@map("ml_model_runs")
}

/// One row per (metric, granularity, target period, optional branch/item)
/// prediction. `actualValue` is backfilled once the period has passed
/// (ExecutiveService reads both to render forecast-vs-actual) — left null
/// until then rather than requiring a second write path.
model ForecastSnapshot {
  id                String              @id @default(uuid())
  modelRunId        String              @map("model_run_id")
  modelRun          MlModelRun          @relation(fields: [modelRunId], references: [id], onDelete: Cascade)
  metric            ForecastMetric
  granularity       ForecastGranularity
  targetPeriodStart DateTime            @map("target_period_start")
  branchId          String?             @map("branch_id")
  branch            Branch?             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItemId        String?             @map("menu_item_id")
  menuItem          MenuItem?           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItemId   String?             @map("inventory_item_id")
  inventoryItem     InventoryItem?      @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  predictedValue    Decimal             @map("predicted_value") @db.Decimal(14, 3)
  confidence        Decimal             @db.Decimal(4, 3)
  actualValue       Decimal?            @map("actual_value") @db.Decimal(14, 3)
  createdAt         DateTime            @default(now()) @map("created_at")

  @@index([metric, granularity, targetPeriodStart])
  @@index([branchId, metric, targetPeriodStart])
  @@index([menuItemId, targetPeriodStart])
  @@index([inventoryItemId, targetPeriodStart])
  @@map("forecast_snapshots")
}

/// Audit trail of AI Assistant Q&A — `toolCalls` records which intelligence
/// service methods were invoked and their raw results, so every answer is
/// traceable back to the real data it cites (never a bare LLM claim).
model AiAssistantQuery {
  id            String         @id @default(uuid())
  askedByUserId String?        @map("asked_by_user_id")
  askedByUser   User?          @relation(fields: [askedByUserId], references: [id])
  question      String
  answer        String
  toolCalls     Json?          @map("tool_calls")
  outcome       AiQueryOutcome
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([askedByUserId, createdAt])
  @@map("ai_assistant_queries")
}

// ---------------------------------------------------------------------------
// AI Memory & Vector Index (Phase 7)
// ---------------------------------------------------------------------------

enum AiMemoryKind {
  CONVERSATION
  DECISION
  RECOMMENDATION
  ACCEPTED_SUGGESTION
  REJECTED_SUGGESTION
  EXPLANATION
  // Phase 11 Part 3 — Restaurant Memory categories (see AiMemoryService).
  CUSTOMER_PREFERENCE
  MANAGER_FEEDBACK
  CAMPAIGN_HISTORY
  SUPPLIER_ISSUE
  INVENTORY_FAILURE
  HOLIDAY_DEMAND
  BRANCH_BEHAVIOR
  STAFF_PERFORMANCE
  LEARNING_DIGEST
}

/// Long-term memory for the Restaurant Intelligence Platform (Phase 7) —
/// one row per remembered conversation turn, business decision, AI
/// recommendation, or accept/reject outcome, scoped by `domain` (e.g.
/// "executive", "sales-ai") so each domain service can recall only its own
/// history. Embeddings live in `VectorEntry` (namespace "ai-memory", keyed
/// by this row's id) rather than on this table, so the RAG store stays
/// swappable to an external VectorProvider without an AiMemoryEntry schema
/// change — see EmbeddingBackfillWorker for indexing entries written
/// before AI_RAG_ENABLED was turned on.
model AiMemoryEntry {
  id            String       @id @default(uuid())
  kind          AiMemoryKind
  domain        String
  title         String
  content       String
  metadata      Json?
  branchId      String?      @map("branch_id")
  branch        Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  subjectUserId String?      @map("subject_user_id")
  subjectUser   User?        @relation("AiMemorySubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  authorUserId  String?      @map("author_user_id")
  authorUser    User?        @relation("AiMemoryAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([domain, kind, createdAt])
  @@index([branchId, createdAt])
  @@map("ai_memory_entries")
}

/// Provider-agnostic vector store used by the default (zero-external-
/// dependency) `PgVectorProvider` — application code computes cosine
/// similarity over `embedding` rather than requiring the Postgres
/// `pgvector` extension. Only used when VECTOR_PROVIDER=pgvector (the
/// default); OpenSearch/Pinecone/Qdrant providers keep their own storage
/// remotely and never touch this table. `namespace` partitions unrelated
/// indexes (e.g. "ai-memory", "menu-catalog") within the one table.
model VectorEntry {
  id        String   @id @default(uuid())
  namespace String
  content   String?
  metadata  Json?
  embedding Float[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([namespace])
  @@map("vector_entries")
}

// ---------------------------------------------------------------------------
// Predictive Intelligence Platform (Phase 11 Part 2)
// ---------------------------------------------------------------------------

enum PredictiveModelStage {
  EXPERIMENTAL
  STAGING
  PRODUCTION
  ARCHIVED
}

enum DriftType {
  FEATURE_DRIFT
  PREDICTION_DRIFT
  DATA_DRIFT
  CONCEPT_DRIFT
}

enum DriftSeverity {
  LOW
  MEDIUM
  HIGH
}

/// A richer, standalone registry from Phase 6's `MlModelRun` (which only
/// tracks forecast-generation runs) — this one tracks every hand-rolled
/// "model" in prediction/, segmentation/, and forecasting/, with the
/// deployment-stage lifecycle and dataset lineage Phase 6 never needed.
/// Deliberately a new table rather than adding these columns to
/// `MlModelRun`, so Phase 6's forecasting code and schema stay untouched.
model PredictiveModelRun {
  id              String               @id @default(uuid())
  modelKey        String               @map("model_key")
  version         Int
  status          MlModelStatus        @default(READY)
  deploymentStage PredictiveModelStage @default(EXPERIMENTAL) @map("deployment_stage")
  datasetHash     String               @map("dataset_hash")
  datasetVersion  String               @map("dataset_version")
  sampleCount     Int                  @map("sample_count")
  featureSchema   Json                 @map("feature_schema")
  metrics         Json?
  notes           String?
  trainedAt       DateTime             @default(now()) @map("trained_at")

  @@unique([modelKey, version])
  @@index([modelKey, deploymentStage])
  @@map("predictive_model_runs")
}

/// One row per detected drift event — feature/prediction/data/concept —
/// surfaced at `GET /admin/ai/drift` and the trigger record consulted by
/// the retraining pipeline (training/retraining.service.ts).
model DriftAlert {
  id            String        @id @default(uuid())
  modelKey      String        @map("model_key")
  driftType     DriftType     @map("drift_type")
  severity      DriftSeverity
  metricName    String        @map("metric_name")
  baselineValue Float         @map("baseline_value")
  currentValue  Float         @map("current_value")
  detail        String
  detectedAt    DateTime      @default(now()) @map("detected_at")
  resolvedAt    DateTime?     @map("resolved_at")

  @@index([modelKey, detectedAt])
  @@index([resolvedAt])
  @@map("drift_alerts")
}

// ---------------------------------------------------------------------------
// Autonomous Restaurant Intelligence Platform (Phase 11 Part 3)
// ---------------------------------------------------------------------------

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApprovalActionType {
  REFUND
  DELETE
  DISCOUNT
  PROMOTION
  INVENTORY_PURCHASE_ORDER
  PRICE_CHANGE
  MARKETING_CAMPAIGN
  STAFFING_CHANGE
  OTHER
}

/// The Human Approval Layer — every irreversible or high-risk action an AI
/// component wants to take (auto-drafted PO, discount, promotion, refund,
/// price change) is written here as PENDING instead of executed directly.
/// `payload` carries whatever the eventual executor (see
/// `ApprovalExecutorRegistry`) needs to perform the action once a manager
/// approves it — the AI never bypasses this table for the action types
/// above, matching this platform's standing "never perform an irreversible
/// action autonomously" rule.
model AiApprovalRequest {
  id               String             @id @default(uuid())
  actionType       ApprovalActionType @map("action_type")
  riskLevel        ApprovalRiskLevel  @map("risk_level")
  summary          String
  payload          Json
  status           ApprovalStatus     @default(PENDING)
  requestedByAgent String             @map("requested_by_agent")
  reviewedByUserId String?            @map("reviewed_by_user_id")
  reviewedByUser   User?              @relation("AiApprovalReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?          @map("reviewed_at")
  reviewNotes      String?            @map("review_notes")
  branchId         String?            @map("branch_id")
  branch           Branch?            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt        DateTime           @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([actionType, status])
  @@map("ai_approval_requests")
}

enum WorkflowTriggerType {
  EVENT
  SCHEDULE
  MANUAL
}

enum WorkflowRunStatus {
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
}

/// AI Workflow Engine — an if/then step chain (e.g. "inventory low ->
/// supplier available -> auto-create PO draft -> notify manager -> track
/// approval -> receive inventory -> update stock"). `triggerConfig` and
/// `steps` are small JSON DSLs interpreted by `WorkflowEngineService`, not
/// arbitrary code — see intelligence/workflows/workflow-step.types.ts for
/// the step-kind union this platform actually supports (v1 scope).
model AiWorkflowDefinition {
  id            String              @id @default(uuid())
  name          String
  description   String?
  triggerType   WorkflowTriggerType @map("trigger_type")
  triggerConfig Json                @map("trigger_config")
  steps         Json
  enabled       Boolean             @default(true)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  runs          AiWorkflowRun[]

  @@map("ai_workflow_definitions")
}

/// One row per execution of an `AiWorkflowDefinition` — `stepLog` records
/// each step's outcome in order, so a run's full trace is reconstructable
/// without re-running it.
model AiWorkflowRun {
  id          String               @id @default(uuid())
  workflowId  String               @map("workflow_id")
  workflow    AiWorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status      WorkflowRunStatus    @default(RUNNING)
  context     Json
  stepLog     Json                 @map("step_log")
  startedAt   DateTime             @default(now()) @map("started_at")
  completedAt DateTime?            @map("completed_at")

  @@index([workflowId, startedAt])
  @@map("ai_workflow_runs")
}

enum KnowledgeSourceFormat {
  MARKDOWN
  PLAIN_TEXT
  PDF
  DOCX
  IMAGE
}

/// AI Knowledge Base — policies, recipes, training manuals, food safety,
/// HR policies, supplier agreements, marketing/architecture/API docs.
/// `content` is always the plain-text/markdown actually indexed into
/// `VectorEntry` (namespace "ai-knowledge-base"); `sourceFormat` records
/// what the original document was so a future binary-parsing pipeline
/// (PDF/DOCX/OCR) has somewhere to write extracted text — this phase
/// deliberately does not ship that parser (see docs/ROADMAP.md's Part 3
/// scope notes), so PDF/DOCX/IMAGE documents must be ingested as
/// pre-extracted text today.
model AiKnowledgeDocument {
  id           String                @id @default(uuid())
  title        String
  category     String
  content      String
  sourceFormat KnowledgeSourceFormat @default(MARKDOWN) @map("source_format")
  metadata     Json?
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  @@index([category])
  @@map("ai_knowledge_documents")
}

/// Continuous Evaluation — a time series of measured metric values
/// (accuracy/precision/recall/latency/etc.) so `EvaluationTrackerService`
/// can report trends rather than a single snapshot.
model AiEvaluationRecord {
  id         String   @id @default(uuid())
  metricName String   @map("metric_name")
  modelKey   String?  @map("model_key")
  value      Float
  context    Json?
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@index([metricName, recordedAt])
  @@map("ai_evaluation_records")
}

enum RecommendationOutcomeStatus {
  PENDING
  ACCEPTED
  REJECTED
  IGNORED
}

/// Tracks whether a human accepted/rejected an AI recommendation — the
/// basis for the "Recommendation Acceptance" and business-impact/ROI
/// metrics `EvaluationTrackerService` reports. `flaggedHallucination` is a
/// manual flag (an admin marks a recommendation as unfounded) rather than
/// an automatic detector — this platform has no ground-truth signal to
/// measure hallucination rate automatically, a documented gap.
model AiRecommendationOutcome {
  id                   String                      @id @default(uuid())
  source               String
  recommendation       String
  status               RecommendationOutcomeStatus @default(PENDING)
  estimatedImpact      Float?                      @map("estimated_impact")
  actualImpact         Float?                      @map("actual_impact")
  decidedByUserId      String?                     @map("decided_by_user_id")
  decidedByUser        User?                       @relation("AiRecommendationDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedAt            DateTime?                   @map("decided_at")
  flaggedHallucination Boolean                     @default(false) @map("flagged_hallucination")
  createdAt            DateTime                    @default(now()) @map("created_at")

  @@index([source, status])
  @@map("ai_recommendation_outcomes")
}

// ---------------------------------------------------------------------------
// Enterprise & Global Restaurant Platform (Phase 8 Part 1) — Enterprise
// Foundation: multi-tenant architecture, organization/franchise/region
// hierarchy, feature flags, licensing, global config. See
// docs/ROADMAP.md's Phase 8 section for the additive-tenancy scope
// decision this section implements.
// ---------------------------------------------------------------------------

/// The tenant root. Every Branch belongs to exactly one Organization
/// (see the Branch model). One Organization existed implicitly before
/// this phase — the migration backfills it as "Fresh Cup" so every
/// pre-existing branch/user keeps working unchanged.
model Organization {
  id                    String             @id @default(uuid())
  name                  String
  slug                  String             @unique
  domain                String?            @unique
  status                OrganizationStatus @default(TRIAL)
  timezone              String             @default("Africa/Addis_Ababa")
  defaultLocale         Locale             @default(EN) @map("default_locale")
  defaultCurrencyCode   String             @default("ETB") @map("default_currency_code")
  onboardingCompletedAt DateTime?          @map("onboarding_completed_at")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  branches             Branch[]
  regions              Region[]
  franchises           Franchise[]
  branchGroups         BranchGroup[]
  memberships          OrganizationMembership[]
  featureFlagOverrides FeatureFlagOverride[]
  subscription         OrganizationSubscription?
  globalConfigEntries  GlobalConfigEntry[]
  ssoConnections       SsoConnection[]
  scimTokens           ScimToken[]
  ipAllowlistEntries   IpAllowlistEntry[]
  enterpriseAuditLogs  EnterpriseAuditLog[]

  @@map("organizations")
}

/// A geographic/administrative grouping of branches within an
/// Organization (e.g. "Addis Ababa", "Oromia") — distinct from Franchise,
/// which groups branches by ownership rather than geography.
model Region {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  countryCode    String       @map("country_code")
  timezone       String
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  branches Branch[]

  @@unique([organizationId, code])
  @@map("regions")
}

/// A franchisee-operated grouping of branches within an Organization.
/// `ownerUserId` is the franchise owner's account; FRANCHISE_ADMIN
/// OrgRole holders manage a franchise's branches without needing
/// ORG_ADMIN over the whole tenant.
model Franchise {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  ownerUserId    String?      @map("owner_user_id")
  ownerUser      User?        @relation("FranchiseOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  branches Branch[]

  @@map("franchises")
}

/// A free-form, many-to-many branch grouping (e.g. "high-volume
/// branches", "pilot locations") — distinct from Region/Franchise, which
/// are each a branch's single geographic/ownership parent. A branch can
/// belong to any number of BranchGroups.
model BranchGroup {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  memberships BranchGroupMembership[]

  @@unique([organizationId, name])
  @@map("branch_groups")
}

model BranchGroupMembership {
  id            String      @id @default(uuid())
  branchGroupId String      @map("branch_group_id")
  branchGroup   BranchGroup @relation(fields: [branchGroupId], references: [id], onDelete: Cascade)
  branchId      String      @map("branch_id")
  branch        Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([branchGroupId, branchId])
  @@map("branch_group_memberships")
}

/// Org-level role grant — see the OrgRole enum comment for why this is a
/// second, additive role axis on top of the existing branch-scoped
/// UserRole rather than a replacement for it.
model OrganizationMembership {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([organizationId, userId])
  @@map("organization_memberships")
}

/// The global registry of feature flag keys this platform knows about —
/// `defaultEnabled` is what a flag evaluates to when no
/// FeatureFlagOverride exists for the organization/branch being checked.
model FeatureFlagDefinition {
  id             String   @id @default(uuid())
  key            String   @unique
  name           String
  description    String?
  defaultEnabled Boolean  @default(false) @map("default_enabled")
  createdAt      DateTime @default(now()) @map("created_at")

  overrides FeatureFlagOverride[]

  @@map("feature_flag_definitions")
}

/// An organization- (or, optionally, branch-) scoped override of a
/// feature flag's default. `rolloutPercentage` supports a partial rollout
/// (deterministically hashed by entity id in FeatureFlagsService, not
/// randomized per request) when `enabled` is true but the flag should
/// only apply to a fraction of eligible branches.
model FeatureFlagOverride {
  id                String                @id @default(uuid())
  organizationId    String                @map("organization_id")
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  featureFlagId     String                @map("feature_flag_id")
  featureFlag       FeatureFlagDefinition @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)
  branchId          String?               @map("branch_id")
  branch            Branch?               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  enabled           Boolean
  rolloutPercentage Int?                  @map("rollout_percentage")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@unique([organizationId, featureFlagId, branchId])
  @@map("feature_flag_overrides")
}

/// A sellable plan tier. `features` is a JSON array of feature flag keys
/// entitled by this plan — `LicenseService.isEntitled()` checks it before
/// a FeatureFlagOverride is even consulted, so a plan downgrade can
/// disable a feature without deleting its override rows.
model SubscriptionPlan {
  id                String   @id @default(uuid())
  key               String   @unique
  name              String
  maxBranches       Int?     @map("max_branches")
  maxUsers          Int?     @map("max_users")
  priceMonthlyMinor Int?     @map("price_monthly_minor")
  features          Json
  createdAt         DateTime @default(now()) @map("created_at")

  subscriptions OrganizationSubscription[]

  @@map("subscription_plans")
}

/// One active subscription per Organization. `seats` is the licensed
/// user count `LicenseService.checkSeatLimit()` enforces against actual
/// active User rows in that organization's branches.
model OrganizationSubscription {
  id                 String             @id @default(uuid())
  organizationId     String             @unique @map("organization_id")
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId             String             @map("plan_id")
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(TRIALING)
  seats              Int                @default(1)
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@map("organization_subscriptions")
}

/// Tenant-scoped key-value configuration store (branding, defaults,
/// integration settings) — deliberately untyped JSON `value` rather than
/// a column-per-setting table, since the set of settings an enterprise
/// tenant wants to override is open-ended and growing this by migration
/// every time would defeat the point of a "global configuration service."
model GlobalConfigEntry {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  value          Json
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([organizationId, key])
  @@map("global_config_entries")
}

// ---------------------------------------------------------------------------
// Enterprise & Global Restaurant Platform (Phase 8 Part 2) — Enterprise
// Security: SSO (OIDC-based Google Workspace/Entra ID/Okta + SAML 2.0),
// SCIM provisioning, WebAuthn hardware security keys, IP allowlisting,
// device trust, and a hash-chained enterprise audit trail. See
// docs/ROADMAP.md's Phase 8 Part 2 scope notes for the security-boundary
// decisions this section documents (SAML signature verification and full
// WebAuthn attestation both require a dedicated, security-reviewed
// library this phase does not add).
// ---------------------------------------------------------------------------

enum SsoProviderType {
  GOOGLE_WORKSPACE
  MICROSOFT_ENTRA_ID
  OKTA
  GENERIC_OIDC
  SAML
}

/// An org's configured identity provider. `config` holds non-secret
/// values only (issuer/authorization/token/JWKS endpoints, client id,
/// SAML entity id/ACS URL/IdP SSO URL) — the client secret is never
/// stored here; `clientSecretEnvVar` names the environment variable
/// `SsoOidcProvider` reads it from at request time, the same
/// env-var-indirection pattern `LlmProvider` factories use for API keys.
model SsoConnection {
  id                 String          @id @default(uuid())
  organizationId     String          @map("organization_id")
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider           SsoProviderType
  name               String
  domainHint         String?         @map("domain_hint")
  config             Json
  clientSecretEnvVar String?         @map("client_secret_env_var")
  isEnabled          Boolean         @default(true) @map("is_enabled")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("sso_connections")
}

/// A SCIM 2.0 bearer token for automated user provisioning from an IdP.
/// `tokenHash` only — the raw token is shown once at creation and never
/// stored or returned again, same convention as RefreshToken.
model ScimToken {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  tokenHash      String       @unique @map("token_hash")
  lastUsedAt     DateTime?    @map("last_used_at")
  revokedAt      DateTime?    @map("revoked_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("scim_tokens")
}

/// A registered WebAuthn hardware security key. `publicKeyCose` is the
/// raw COSE_Key bytes from registration (base64); `signCount` is the
/// authenticator's signature counter, checked on every assertion to
/// detect cloned authenticators (must strictly increase).
model WebAuthnCredential {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId  String    @unique @map("credential_id")
  publicKeyCose String    @map("public_key_cose")
  signCount     Int       @default(0) @map("sign_count")
  deviceName    String?   @map("device_name")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastUsedAt    DateTime? @map("last_used_at")

  @@index([userId])
  @@map("webauthn_credentials")
}

/// A one-time WebAuthn registration/assertion challenge, consumed
/// (deleted) on use. Short-lived — `expiresAt` is enforced by the
/// service, not a DB TTL, since Postgres has no native row expiry.
model WebAuthnChallenge {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  challenge String
  purpose   String
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([userId, purpose])
  @@map("webauthn_challenges")
}

/// An organization-level allowed network range. `cidr` is validated
/// (IPv4/IPv6 CIDR notation) by the DTO before it ever reaches this
/// table. An organization with zero entries has no IP restriction —
/// allowlisting is opt-in per org, not a default-deny posture nobody
/// asked for.
model IpAllowlistEntry {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cidr           String
  description    String?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([organizationId, cidr])
  @@map("ip_allowlist_entries")
}

/// A device a user has explicitly trusted (e.g. "remember this device for
/// 30 days" after MFA) — `fingerprintHash` is a hash of a client-supplied
/// device fingerprint, never the raw fingerprint. Distinct from
/// RefreshToken: a trusted device can outlive any single refresh token
/// and is checked as an additional MFA-bypass signal, not an auth token
/// itself.
model TrustedDevice {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprintHash String    @map("fingerprint_hash")
  deviceName      String?   @map("device_name")
  trustedAt       DateTime  @default(now()) @map("trusted_at")
  lastSeenAt      DateTime  @default(now()) @map("last_seen_at")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")

  @@unique([userId, fingerprintHash])
  @@map("trusted_devices")
}

/// A hash-chained, append-only security audit trail — distinct from
/// Phase 3's general `AuditLog` (which captures admin CRUD mutations
/// across every module). This one is scoped to enterprise security
/// events (SSO login, SCIM provisioning, WebAuthn registration, IP
/// allowlist changes, trusted-device changes) and each row's `hash`
/// commits to `previousHash`, so any row tampered with or deleted breaks
/// the chain from that point forward — detectable, not just logged.
model EnterpriseAuditLog {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUserId    String?      @map("actor_user_id")
  eventType      String       @map("event_type")
  detail         Json
  previousHash   String?      @map("previous_hash")
  hash           String
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@map("enterprise_audit_logs")
}
