# Copy to .env.local for local development (docker-compose defaults shown below).

NODE_ENV=development
PORT=4000

# PostgreSQL — matches infra/docker/docker-compose.yml
DATABASE_URL="postgresql://fresh_cup:fresh_cup@localhost:5432/fresh_cup_dev?schema=public"

# Redis — matches infra/docker/docker-compose.yml
REDIS_URL="redis://localhost:6379"

# Allowed CORS origins (frontend dev servers)
WEB_APP_URL="http://localhost:3000"
ADMIN_APP_URL="http://localhost:3001"
DELIVERY_APP_URL="http://localhost:3002"

# Auth — generate a real secret for anything beyond local dev, e.g.
# `openssl rand -base64 48`. Access tokens are short-lived JWTs; refresh
# tokens are opaque random values hashed at rest, so they need no secret.
JWT_ACCESS_SECRET="dev-only-change-me-in-every-other-environment"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# OTP (phone login) — no real SMS gateway is wired up yet (AfroMessage
# integration is Phase 3), so the console SMS provider logs the code
# instead of sending it. The same console provider is used for order
# notifications in Phase 2.
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Chapa payment aggregator (covers TeleBirr, CBE Birr, HelloCash, Amole,
# cards) — leave unset in dev/test to use the sandbox provider, which
# fabricates a checkout reference instead of calling the real API.
# CHAPA_SECRET_KEY=
# CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL="https://api.chapa.co/v1"
CHAPA_RETURN_URL="http://localhost:3000/checkout/return"
CHAPA_CALLBACK_URL="http://localhost:4000/api/v1/payments/webhooks/chapa"

# Checkout — flat delivery fee (minor units) until zone/distance-based
# quoting lands in Phase 3; tax rate defaults to 0 (VAT registration TBD).
DELIVERY_FLAT_FEE=5000
TAX_RATE_PERCENT=0

# Loyalty accrual: 1 point per this many minor units spent (1000 = 1
# point per 10 ETB).
LOYALTY_MINOR_UNITS_PER_POINT=1000

# Seeds one dev user per role when running `pnpm prisma:seed` outside
# production. Leave a pair unset to skip seeding that role.
ADMIN_SEED_EMAIL="admin@freshcup.dev"
ADMIN_SEED_PASSWORD="ChangeMe123!"
MANAGER_SEED_EMAIL="manager@freshcup.dev"
MANAGER_SEED_PASSWORD="ChangeMe123!"
STAFF_SEED_EMAIL="staff@freshcup.dev"
STAFF_SEED_PASSWORD="ChangeMe123!"
DRIVER_SEED_EMAIL="driver@freshcup.dev"
DRIVER_SEED_PASSWORD="ChangeMe123!"

# AI Assistant (Phase 6) — leave unset in dev/test to use the deterministic
# template router instead of the Claude API; same "sandbox fallback"
# pattern as CHAPA_SECRET_KEY above.
# ANTHROPIC_API_KEY=

# --- Added in later phases (documented here so the shape is known up front) ---
# AFROMESSAGE_API_KEY=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_MAPS_API_KEY=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=
